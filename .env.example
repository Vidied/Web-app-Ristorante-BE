# Copia questo file in .env e imposta i valori reali.
# Il file .env è escluso dal versionamento (.gitignore).

# Database
DB_URL=jdbc:postgresql://localhost:5432/capstone
DB_USERNAME=postgres
DB_PASSWORD=cambiami

# JPA
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true

# JWT (segreto di almeno 32 caratteri)
JWT_SECRET=CHANGE_ME_WITH_YOUR_OWN_JWT_SECRET_KEY_AT_LEAST_32_CHARS_LONG
JWT_EXPIRATION=86400000

# Ristorante
RESTAURANT_COVER_PRICE=2.00

# CORS (lista separata da virgole)
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80

# Stampanti
PRINTER_PIZZERIA_PORT=COM3
PRINTER_PIZZERIA_NAME_HINT=PRINTER_PIZZERIA
PRINTER_PIZZERIA_MAX_RETRIES=3
PRINTER_PIZZERIA_RETRY_DELAY_MS=1500

PRINTER_CUCINA_PORT=COM5
PRINTER_CUCINA_NAME_HINT=PRINTER_CUCINA
PRINTER_CUCINA_MAX_RETRIES=3
PRINTER_CUCINA_RETRY_DELAY_MS=1500

PRINTER_SALA_NAME=PRINTER_SALA
PRINTER_SALA_MAX_RETRIES=3
PRINTER_SALA_RETRY_DELAY_MS=1500

PRINTER_RECEIPT_NAME=PRINTER_SALA
PRINTER_RECEIPT_MAX_RETRIES=3
PRINTER_RECEIPT_RETRY_DELAY_MS=1500

PRINTER_HEALTH_CHECK_INTERVAL_MS=180000
